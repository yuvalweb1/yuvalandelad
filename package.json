{
  "name": "recapped",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "WhatsApp Wrapped — cinematic recap of your group chat year. 100% client-side.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node src/parser/zip.test.js && node src/parser/voiceAuthor.test.js",
    "theme": "node scripts/apply-theme.js",
    "sync": "npm run build && npx cap sync",
    "watch": "vite build --watch",
    "android": "npm run sync && npx cap open android",
    "ios": "npm run sync && npx cap open ios"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.0.0",
    "@capacitor/android": "^8.3.4",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.3.4",
    "@capacitor/share": "^8.0.1",
    "country-flag-emoji-polyfill": "^0.1.8",
    "html2canvas": "^1.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.10"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.60.0",
    "sharp": "^0.34.5"
  }
}
